export default function Landing() {
  const [countryModal, setCountryModal] = useState(false);
  const [mobileMenu, setMobileMenu] = useState(false);
  const [chatOpen, setChatOpen] = useState(false);
  const [chatMsg, setChatMsg] = useState("");
  const [chatSent, setChatSent] = useState(false);
  const [showMore, setShowMore] = useState(false);

  /* حركات الظهور عند التمرير */
  useEffect(() => {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add("on")),
      { threshold: 0.1, rootMargin: "0px 0px 50px 0px" }
    );
    const elements = document.querySelectorAll<HTMLElement>(".rv");
    elements.forEach((el) => io.observe(el));
    return () => io.disconnect();
  }, [showMore]);

  return (
    <div className="min-h-screen bg-[#fafbff] text-[#2b2a29] overflow-x-clip selection:bg-[#1d72fe] selection:text-white">
      {/* ===================== الهيدر الثابت ===================== */}
      <header className="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/70">
        <div className="mx-auto max-w-[1440px] px-4 sm:px-8 h-[74px] flex items-center justify-between">
          {/* اليمين: اللوجو */}
          <Link href="/" aria-label="تفوّق">
            <Logo size={40} />
          </Link>

          {/* الوسط: روابط التنقل */}
          <nav className="hidden lg:flex items-center gap-7">
            {NAV_LINKS.map((l) => (
              <a
                key={l.label}
                href={l.href}
                className="text-sm font-bold text-[#2b2a29]/70 hover:text-[#1d72fe] transition-colors"
              >
                {l.label}
              </a>
            ))}
          </nav>

          {/* اليسار: الدولة + الدخول + القائمة */}
          <div className="flex items-center gap-2.5 sm:gap-3">
            <button
              onClick={() => setCountryModal(true)}
              className="hidden sm:flex items-center gap-2 rounded-full border border-slate-200 bg-white hover:bg-slate-50 px-3.5 py-1.5 transition-all text-xs font-bold text-[#2b2a29]/80"
            >
              <KuwaitFlag />
              <span>الكويت</span>
              <Icon name="down" size={13} className="text-slate-400" />
            </button>

            <Link
              href="/login"
              className="group flex items-center gap-2 rounded-full bg-[#1d72fe] hover:bg-[#1560e0] text-white px-6 py-2.5 text-sm font-black transition-all shadow-lg shadow-[#1d72fe]/25 hover:scale-[1.03] active:scale-95"
            >
              <span>ادخل</span>
              <Icon name="back" size={15} className="group-hover:-translate-x-1 transition-transform" />
            </Link>

            <button
              onClick={() => setMobileMenu(!mobileMenu)}
              className="lg:hidden p-2 rounded-xl hover:bg-slate-100 text-[#2b2a29]"
              aria-label="القائمة"
            >
              <Icon name={mobileMenu ? "x" : "grid"} size={20} />
            </button>
          </div>
        </div>

        {/* قائمة الجوال */}
        {mobileMenu && (
          <div className="lg:hidden border-t border-slate-100 bg-white px-4 py-3 space-y-1 animate-fade-up">
            {NAV_LINKS.map((l) => (
              <a
                key={l.label}
                href={l.href}
                onClick={() => setMobileMenu(false)}
                className="block rounded-xl px-4 py-2.5 text-sm font-bold text-[#2b2a29]/75 hover:bg-slate-50 hover:text-[#1d72fe]"
              >
                {l.label}
              </a>
            ))}
            <button
              onClick={() => { setMobileMenu(false); setCountryModal(true); }}
              className="flex w-full items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-[#2b2a29]/75 hover:bg-slate-50"
            >
              <KuwaitFlag />
              <span>الكويت (KWD)</span>
            </button>
          </div>
        )}
      </header>

      {/* ===================== نافذة اختيار الدولة ===================== */}
      {countryModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#2b2a29]/40 backdrop-blur-sm animate-fade-up">
          <div className="w-full max-w-sm rounded-3xl bg-white border border-slate-100 p-6 shadow-2xl relative">
            <button
              onClick={() => setCountryModal(false)}
              className="absolute top-4 left-4 p-1.5 rounded-full hover:bg-slate-100 text-slate-400"
            >
              <Icon name="x" size={18} />
            </button>
            <h3 className="text-lg font-black text-[#2b2a29] text-center mb-1">اختر دولتك</h3>
            <p className="text-xs text-slate-400 text-center mb-6">يعتمد المنهج والعملة على اختيار دولتك</p>

            <div className="space-y-3">
