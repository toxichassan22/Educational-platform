                <div className="flex items-center gap-2.5">
                  <KuwaitFlag />
                  <span>دولة الكويت (KWD)</span>
                </div>
                <Icon name="check" size={16} className="text-[#1d72fe]" />
              </div>
            </div>

            <button
              onClick={() => setCountryModal(false)}
              className="w-full mt-6 py-3 rounded-full bg-[#1d72fe] hover:bg-[#1560e0] font-black text-sm text-white transition-all shadow-lg shadow-[#1d72fe]/30"
            >
              حفظ
            </button>
          </div>
        </div>
      )}

      {/* ===================== الهيرو ===================== */}
      <section className="relative pt-[120px] pb-16 sm:pt-[140px] sm:pb-20 overflow-hidden">
        {/* هالات ملونة ناعمة */}
        <div className="pointer-events-none absolute -top-24 -right-24 w-[420px] h-[420px] rounded-full bg-[#1d72fe]/10 blur-[100px]" />
        <div className="pointer-events-none absolute top-40 -left-32 w-[380px] h-[380px] rounded-full bg-[#f59e0b]/10 blur-[100px]" />

        <div className="relative mx-auto max-w-[1440px] px-4 sm:px-8 grid lg:grid-cols-2 items-center gap-12">
          {/* الجانب الأيمن: النص */}
          <div className="text-center lg:text-right">
            <div className="rv inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-1.5 text-xs font-black text-[#1d72fe] shadow-sm mb-6">
              <KuwaitFlag />
              منصة كويتية · ابتدائي · متوسط · ثانوي
            </div>

            <h1 className="rv font-black leading-[1.15] text-4xl sm:text-6xl xl:text-[4rem] text-[#2b2a29]">
              كل اللي تحتاجه للتفوق
              <br />
              <span className="text-grad-brand">في مكان واحد</span>
            </h1>

            <p
              className="rv mt-6 text-[#9297a6] text-base sm:text-xl font-bold leading-relaxed max-w-xl mx-auto lg:mx-0 lg:ml-auto"
              style={{ "--rvd": "120ms" } as React.CSSProperties}
            >
              ارفع درجاتك مع مذكرات تفوّق الشاملة وفيديوهات الشرح المميزة واختباراتها الذكية — خطة واضحة من أول درس إلى ليلة الامتحان
            </p>

            <div className="rv mt-9 flex flex-wrap items-center justify-center lg:justify-start gap-3" style={{ "--rvd": "200ms" } as React.CSSProperties}>
              <Link
                href="/login"
                className="inline-flex items-center gap-2 bg-[#1d72fe] hover:bg-[#1560e0] text-white font-black text-lg px-10 py-4 rounded-full transition-all hover:scale-[1.03] shadow-xl shadow-[#1d72fe]/30 active:scale-95"
              >
                استكشف المواد
              </Link>
              <a
                href="#top-students"
                className="inline-flex items-center gap-2 border-2 border-slate-200 hover:border-[#1d72fe] text-[#2b2a29]/75 hover:text-[#1d72fe] bg-white font-black text-base px-8 py-[14px] rounded-full transition-all"
              >
                تعرف على المتفوقين
              </a>
            </div>

            <div
              className="rv mt-8 flex items-center justify-center lg:justify-start gap-3"
              style={{ "--rvd": "280ms" } as React.CSSProperties}
            >
              <div className="flex -space-x-2 space-x-reverse">
                {["أ", "س", "ن", "ر"].map((ch, i) => (
                  <span
                    key={i}
                    className="w-9 h-9 rounded-full border-2 border-white flex items-center justify-center text-xs font-black text-white shadow"
                    style={{ background: ["#1d72fe", "#8b5cf6", "#10b981", "#f59e0b"][i] }}
                  >
                    {ch}
                  </span>
                ))}
              </div>
              <div className="text-right">
                <div className="flex items-center gap-1 text-amber-400">
                  {[0, 1, 2, 3, 4].map((i) => (
                    <Icon key={i} name="star" size={14} filled />
                  ))}
                  <span className="text-[#2b2a29] font-black text-sm mr-1" dir="ltr">4.8</span>
                </div>
                <div className="text-[11px] font-bold text-[#9297a6]">يثق بنا آلاف الطلبة وأولياء الأمور</div>
              </div>
            </div>
          </div>

